digraph hotel {
rankdir=LR;
graph [bgcolor="white",pad="0.3",nodesep="0.35",ranksep="0.8"];
node [shape=record,fontname="DejaVu Sans",fontsize=10,style=filled,fillcolor="#edf0ed",color="#1d3045"];
edge [fontname="DejaVu Sans",fontsize=8,color="#627a70"];
"BlokadyPokoi" [label="{BlokadyPokoi|ID_Blokady [PK]|ID_Pokoju [FK]|DataOd|DataDo|Powod|ID_Admina [FK]|DataUtworzenia}"];
"GrafikPracownikow" [label="{GrafikPracownikow|ID_Wpisu [PK]|ID_Pracownika [FK]|Data|TypDnia|GodzinaOd|GodzinaDo}"];
"KategorieUslug" [label="{KategorieUslug|ID_Kategorii [PK]|Nazwa|Opis}"];
"LogAdministratora" [label="{LogAdministratora|ID_Logu [PK]|ID_Admina [FK]|Akcja|Obiekt|ID_Obiektu|Przed|Po|Czas}"];
"Migracje" [label="{Migracje|Nazwa [PK]|Czas}"];
"Platnosci" [label="{Platnosci|ID_Platnosci [PK]|ID_Rezerwacji [FK]|DataPlatnosci|Kwota|Metoda|Status|Typ_platnosci}"];
"Pokoje" [label="{Pokoje|ID_Pokoju [PK]|NrPokoju|ID_Typu [FK]|CenaDobowa|Status|IloscOsob|Pietro|Zdjecie_Pokoju|Aktywny|Wersja}"];
"Pracownicy" [label="{Pracownicy|ID_Pracownika [PK]|ID_Uzytkownika [FK]|ID_Stanowiska [FK]|Aktywny|Opis}"];
"Pracownicy_Uslugi" [label="{Pracownicy_Uslugi|ID_Pracownika [PK] [FK]|ID_Uslugi [PK] [FK]}"];
"Proby_logowania" [label="{Proby_logowania|ID_Proby [PK]|Email|IP|Czas}"];
"Rezerwacje" [label="{Rezerwacje|ID_Rezerwacji [PK]|ID_Pokoju [FK]|ID_Klienta [FK]|ID_Pracownika [FK]|DataOd|DataDo|Kwota|Status|Zrodlo_rezerwacji|Uwagi|LiczbaOsob|Wersja|Archiwum}"];
"Stanowiska" [label="{Stanowiska|ID_Stanowiska [PK]|Nazwa_stanowiska|Placa_brutto|Wersja}"];
"TypyPokoi" [label="{TypyPokoi|ID_Typu [PK]|NazwaTypu|Opis|Wersja}"];
"Uslugi_dodatkowe" [label="{Uslugi_dodatkowe|ID_Uslugi [PK]|Nazwa_Uslugi|Opis|Cena|Czydostepna|ID_Kategorii [FK]|CzasTrwania}"];
"Uzytkownicy" [label="{Uzytkownicy|ID_Uzytkownika [PK]|Imie|Nazwisko|Email|Telefon|Haslo|Rola|Aktywny|DataUtworzenia|Wersja|SesjaWersja}"];
"WizytyUslug" [label="{WizytyUslug|ID_Wizyty [PK]|ID_Klienta [FK]|ID_Pracownika [FK]|ID_Uslugi [FK]|DataOd|DataDo|Cena|Status|Uwagi|Wersja|DataUtworzenia}"];
"ZamowieniaUslugi" [label="{ZamowieniaUslugi|ID_Zamowienia [PK]|ID_Rezerwacji [FK]|ID_Uslugi [FK]|DataZamowienia|Ilosc|Cena_jednostkowa}"];
"BlokadyPokoi" -> "Uzytkownicy" [label="ID_Admina",headlabel="1",taillabel="N"];
"BlokadyPokoi" -> "Pokoje" [label="ID_Pokoju",headlabel="1",taillabel="N"];
"GrafikPracownikow" -> "Pracownicy" [label="ID_Pracownika",headlabel="1",taillabel="N"];
"LogAdministratora" -> "Uzytkownicy" [label="ID_Admina",headlabel="1",taillabel="N"];
"Platnosci" -> "Rezerwacje" [label="ID_Rezerwacji",headlabel="1",taillabel="N"];
"Pokoje" -> "TypyPokoi" [label="ID_Typu",headlabel="1",taillabel="N"];
"Pracownicy" -> "Stanowiska" [label="ID_Stanowiska",headlabel="1",taillabel="N"];
"Pracownicy" -> "Uzytkownicy" [label="ID_Uzytkownika",headlabel="1",taillabel="N"];
"Pracownicy_Uslugi" -> "Pracownicy" [label="ID_Pracownika",headlabel="1",taillabel="N"];
"Pracownicy_Uslugi" -> "Uslugi_dodatkowe" [label="ID_Uslugi",headlabel="1",taillabel="N"];
"Rezerwacje" -> "Uzytkownicy" [label="ID_Klienta",headlabel="1",taillabel="N"];
"Rezerwacje" -> "Pokoje" [label="ID_Pokoju",headlabel="1",taillabel="N"];
"Rezerwacje" -> "Pracownicy" [label="ID_Pracownika",headlabel="1",taillabel="N"];
"Uslugi_dodatkowe" -> "KategorieUslug" [label="ID_Kategorii",headlabel="1",taillabel="N"];
"WizytyUslug" -> "Uzytkownicy" [label="ID_Klienta",headlabel="1",taillabel="N"];
"WizytyUslug" -> "Pracownicy" [label="ID_Pracownika",headlabel="1",taillabel="N"];
"WizytyUslug" -> "Uslugi_dodatkowe" [label="ID_Uslugi",headlabel="1",taillabel="N"];
"ZamowieniaUslugi" -> "Rezerwacje" [label="ID_Rezerwacji",headlabel="1",taillabel="N"];
"ZamowieniaUslugi" -> "Uslugi_dodatkowe" [label="ID_Uslugi",headlabel="1",taillabel="N"];
}