digraph G {
graph [rankdir=LR,bgcolor="#f5f5ef",pad="0.4",nodesep="0.3",ranksep="0.9",fontname="DejaVu Sans",label="Grand Access Hotel — etapy 1–3 / V2",labelloc=t,fontsize=22];
node [shape=plain,fontname="DejaVu Sans",fontsize=10];
edge [color="#80978c",fontname="DejaVu Sans",fontsize=8];
"GrafikPracownikow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>GrafikPracownikow</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Wpisu</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Pracownika</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Data</TD><TD ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT"> TypDnia</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"> GodzinaOd</TD><TD ALIGN="LEFT">time ?</TD></TR><TR><TD ALIGN="LEFT"> GodzinaDo</TD><TD ALIGN="LEFT">time ?</TD></TR></TABLE>>];
"KategorieUslug" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>KategorieUslug</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Kategorii</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">UQ Nazwa</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT"> Opis</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
"LogAdministratora" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>LogAdministratora</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Logu</TD><TD ALIGN="LEFT">bigint(20)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Admina</TD><TD ALIGN="LEFT">int(11) ?</TD></TR><TR><TD ALIGN="LEFT"> Akcja</TD><TD ALIGN="LEFT">varchar(80)</TD></TR><TR><TD ALIGN="LEFT">IDX Obiekt</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT"> ID_Obiektu</TD><TD ALIGN="LEFT">int(11) ?</TD></TR><TR><TD ALIGN="LEFT"> Przed</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"> Po</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT">IDX Czas</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
"Migracje" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Migracje</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK Nazwa</TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"> Czas</TD><TD ALIGN="LEFT">datetime ?</TD></TR></TABLE>>];
"Platnosci" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Platnosci</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Platnosci</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Rezerwacji</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> DataPlatnosci</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"> Kwota</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR><TR><TD ALIGN="LEFT"> Metoda</TD><TD ALIGN="LEFT">varchar(50) ?</TD></TR><TR><TD ALIGN="LEFT"> Status</TD><TD ALIGN="LEFT">varchar(50) ?</TD></TR><TR><TD ALIGN="LEFT"> Typ_platnosci</TD><TD ALIGN="LEFT">varchar(50) ?</TD></TR></TABLE>>];
"Pokoje" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Pokoje</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Pokoju</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">UQ NrPokoju</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Typu</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> CenaDobowa</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR><TR><TD ALIGN="LEFT">IDX Status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"> IloscOsob</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Pietro</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Zdjecie_Pokoju</TD><TD ALIGN="LEFT">varchar(255) ?</TD></TR></TABLE>>];
"Pracownicy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Pracownicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Pracownika</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">UQ FK ID_Uzytkownika</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Stanowiska</TD><TD ALIGN="LEFT">int(11) ?</TD></TR><TR><TD ALIGN="LEFT"> Aktywny</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR><TR><TD ALIGN="LEFT"> Opis</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
"Pracownicy_Uslugi" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Pracownicy_Uslugi</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK ID_Pracownika</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">PK FK ID_Uslugi</TD><TD ALIGN="LEFT">int(11)</TD></TR></TABLE>>];
"Proby_logowania" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Proby_logowania</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Proby</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX Email</TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"> IP</TD><TD ALIGN="LEFT">varchar(45)</TD></TR><TR><TD ALIGN="LEFT"> Czas</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
"Rezerwacje" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Rezerwacje</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Rezerwacji</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Pokoju</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Klienta</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Pracownika</TD><TD ALIGN="LEFT">int(11) ?</TD></TR><TR><TD ALIGN="LEFT">IDX DataOd</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"> DataDo</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"> Kwota</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR><TR><TD ALIGN="LEFT"> Status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"> Zrodlo_rezerwacji</TD><TD ALIGN="LEFT">varchar(50) ?</TD></TR><TR><TD ALIGN="LEFT"> Uwagi</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
"Stanowiska" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Stanowiska</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Stanowiska</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Nazwa_stanowiska</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT"> Placa_brutto</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR></TABLE>>];
"TypyPokoi" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>TypyPokoi</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Typu</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> NazwaTypu</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT"> Opis</TD><TD ALIGN="LEFT">text ?</TD></TR></TABLE>>];
"Uslugi_dodatkowe" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Uslugi_dodatkowe</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Uslugi</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Nazwa_Uslugi</TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"> Opis</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD ALIGN="LEFT"> Cena</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR><TR><TD ALIGN="LEFT"> Czydostepna</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Kategorii</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> CzasTrwania</TD><TD ALIGN="LEFT">int(11)</TD></TR></TABLE>>];
"Uzytkownicy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>Uzytkownicy</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Uzytkownika</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Imie</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT"> Nazwisko</TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT">UQ Email</TD><TD ALIGN="LEFT">varchar(100)</TD></TR><TR><TD ALIGN="LEFT"> Telefon</TD><TD ALIGN="LEFT">varchar(20) ?</TD></TR><TR><TD ALIGN="LEFT"> Haslo</TD><TD ALIGN="LEFT">varchar(255)</TD></TR><TR><TD ALIGN="LEFT"> Rola</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"> Aktywny</TD><TD ALIGN="LEFT">tinyint(1)</TD></TR><TR><TD ALIGN="LEFT"> DataUtworzenia</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
"WizytyUslug" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>WizytyUslug</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Wizyty</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Klienta</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Pracownika</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Uslugi</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> DataOd</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"> DataDo</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"> Cena</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR><TR><TD ALIGN="LEFT">IDX Status</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"> Uwagi</TD><TD ALIGN="LEFT">varchar(1000) ?</TD></TR><TR><TD ALIGN="LEFT"> Wersja</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> DataUtworzenia</TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
"ZamowieniaUslugi" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#b7c5b7"><TR><TD COLSPAN="2" BGCOLOR="#174d40"><FONT COLOR="white"><B>ZamowieniaUslugi</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK ID_Zamowienia</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Rezerwacji</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT">IDX FK ID_Uslugi</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> DataZamowienia</TD><TD ALIGN="LEFT">datetime</TD></TR><TR><TD ALIGN="LEFT"> Ilosc</TD><TD ALIGN="LEFT">int(11)</TD></TR><TR><TD ALIGN="LEFT"> Cena_jednostkowa</TD><TD ALIGN="LEFT">decimal(10,2)</TD></TR></TABLE>>];
"Uzytkownicy" -> "WizytyUslug" [label="ID_Klienta",taillabel="1",headlabel="0..N"];
"Pracownicy" -> "WizytyUslug" [label="ID_Pracownika",taillabel="1",headlabel="0..N"];
"Uslugi_dodatkowe" -> "WizytyUslug" [label="ID_Uslugi",taillabel="1",headlabel="0..N"];
"Pokoje" -> "Rezerwacje" [label="ID_Pokoju",taillabel="1",headlabel="0..N"];
"Uzytkownicy" -> "Rezerwacje" [label="ID_Klienta",taillabel="1",headlabel="0..N"];
"Pracownicy" -> "Rezerwacje" [label="ID_Pracownika",taillabel="0..1",headlabel="0..N"];
"Uzytkownicy" -> "Pracownicy" [label="ID_Uzytkownika",taillabel="1",headlabel="0..1"];
"Stanowiska" -> "Pracownicy" [label="ID_Stanowiska",taillabel="0..1",headlabel="0..N"];
"Rezerwacje" -> "ZamowieniaUslugi" [label="ID_Rezerwacji",taillabel="1",headlabel="0..N"];
"Uslugi_dodatkowe" -> "ZamowieniaUslugi" [label="ID_Uslugi",taillabel="1",headlabel="0..N"];
"TypyPokoi" -> "Pokoje" [label="ID_Typu",taillabel="1",headlabel="0..N"];
"Uzytkownicy" -> "LogAdministratora" [label="ID_Admina",taillabel="0..1",headlabel="0..N"];
"KategorieUslug" -> "Uslugi_dodatkowe" [label="ID_Kategorii",taillabel="1",headlabel="0..N"];
"Pracownicy" -> "Pracownicy_Uslugi" [label="ID_Pracownika",taillabel="1",headlabel="0..N"];
"Uslugi_dodatkowe" -> "Pracownicy_Uslugi" [label="ID_Uslugi",taillabel="1",headlabel="0..N"];
"Pracownicy" -> "GrafikPracownikow" [label="ID_Pracownika",taillabel="1",headlabel="0..N"];
"Rezerwacje" -> "Platnosci" [label="ID_Rezerwacji",taillabel="1",headlabel="0..N"];
}